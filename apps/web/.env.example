# Storva Web App local environment
# PostgreSQL is optional in local development.
DATABASE_URL=""

# Keep this outside apps/web so application updates cannot overwrite user state.
# Windows example: C:\\ProgramData\\Storva\\data
# Linux example: /var/lib/storva
# macOS example: /Users/<user>/Library/Application Support/Storva/data
STORVA_DATA_DIR=""

SIGNING_PRIVATE_KEY="change-me-to-a-random-secret-at-least-32-characters"
STORVA_AGENT_URL="http://127.0.0.1:5125"
NEXT_PUBLIC_APP_URL="http://localhost:8787"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
